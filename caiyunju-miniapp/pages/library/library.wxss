/* pages/library/library.wxss · v2.1 财运簿样式（★ UI_RULES.md 安全区适配） */

/* ============ 页面容器（★ R2：顶部安全区） ============ */
.lib-page {
  min-height: 100vh;
  background-color: var(--color-bg-primary, #0A0E27);
  padding-bottom: 40rpx;

  /* ★ R2：避开状态栏 + 胶囊按钮（对齐 sign 打样）★ */
  padding-top: var(--safe-top, 120rpx);
  box-sizing: border-box;
}

/* 品牌栏 */
.lib-brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 24rpx 20rpx;
}
.compass-mini {
  width: 48rpx; height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D4A853, #B8923F);
  display: flex; align-items: center; justify-content: center;
}
.taiji-mini {
  width: 28rpx; height: 28rpx;
  border-radius: 50%;
  background: #0A0E27;
  border: 2px solid rgba(255,255,255,0.3);
}
.brand-text { display: flex; flex-direction: column; gap: 2rpx; }
.brand-cn { font-size: 34rpx; color: var(--color-gold, #D4A853); font-weight: 600; letter-spacing: 6rpx; }
.brand-en { font-size: 18rpx; color: var(--color-text-hint); letter-spacing: 2rpx; }

/* 分区 */
.lib-section { margin: 0 24rpx 24rpx; }

/* 标题行 */
.lib-h { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.lib-h-bar { width: 4rpx; height: 24rpx; background: var(--color-gold, #D4A853); border-radius: 2rpx; }
.lib-h-name { font-size: 28rpx; color: var(--color-text-primary); font-weight: 500; letter-spacing: 4rpx; }
.lib-h-hint { font-size: 20rpx; color: var(--color-text-hint); margin-left: auto; }

/* 已购卡片 */
.lib-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--color-bg-tertiary, #1a1f3b);
  border-radius: var(--radius-md, 10px);
  border: 1px solid var(--color-border-light);
}
.lib-card-paid { border-color: rgba(212,168,83,0.25); }
.lib-paid-tag {
  background: var(--color-gold, #D4A853);
  color: #0A0E27;
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}
.lib-paid-body { flex: 1; margin-left: 16rpx; }
.lib-paid-title { display: block; font-size: 28rpx; color: var(--color-text-primary); font-weight: 500; }
.lib-paid-desc { display: block; font-size: 22rpx; color: var(--color-text-hint); margin-top: 4rpx; }
.lib-arrow { font-size: 36rpx; color: var(--color-gold, #D4A853); }

/* 空状态 */
.lib-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 24rpx;
  border-radius: var(--radius-md, 10px);
  border: 1px dashed var(--color-border);
}
.lib-empty-icon { font-size: 48rpx; color: var(--color-text-hint); margin-bottom: 12rpx; }
.lib-empty-text { font-size: 26rpx; color: var(--color-text-secondary); text-align: center; }

/* 统计行 */
.lib-stat-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.lib-stat-cell {
  flex: 1;
  text-align: center;
  padding: 20rpx 12rpx;
  background: var(--color-bg-tertiary, #1a1f3b);
  border-radius: var(--radius-sm, 6px);
  border: 1px solid var(--color-border-light);
}
.lib-stat-num { display: block; font-size: 26rpx; color: var(--color-text-primary); font-weight: 500; }
.lib-stat-key { display: block; font-size: 20rpx; color: var(--color-text-hint); margin-top: 4rpx; }

/* 历史列表 */
.lib-history-row {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  margin-bottom: 8rpx;
  background: var(--color-bg-secondary, #111638);
  border-radius: var(--radius-sm, 6px);
  border-left: 4rpx solid transparent;
}
.lib-h-date {
  width: 90rpx;
  font-size: 22rpx;
  color: rgba(245,241,232,0.55);
  flex-shrink: 0;
  letter-spacing: 1rpx;
}
.lib-h-mid { flex: 1; margin: 0 12rpx; }
.lib-h-no { display: block; font-size: 24rpx; color: var(--color-text-primary); }
.lib-h-action { display: block; font-size: 20rpx; color: var(--color-text-hint); margin-top: 2rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.lib-h-grade {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}
.lib-g-shangshang { color: #D4A853; background: rgba(212,168,83,0.12); }
.lib-g-shangji   { color: #C89A5B; background: rgba(200,154,91,0.12); }
.lib-g-zhongji   { color: #8A9A7D; background: rgba(138,154,125,0.12); }
.lib-g-zhongping { color: #8A8DA0; background: rgba(138,141,160,0.12); }
.lib-g-xiaxia    { color: #B8334A; background: rgba(184,51,74,0.12); }

/* 底部（★ R5：TabBar 不遮挡最后一行） */
.lib-footer {
  text-align: center;
  font-size: 20rpx;
  color: var(--color-text-hint);
  padding: 32rpx 24rpx;
  padding-bottom: calc(32rpx + 100rpx);  /* ★ R5：额外 100rpx 避开 TabBar */
  letter-spacing: 2rpx;
}
